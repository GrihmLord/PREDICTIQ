{
  "name": "PREDICTIQ",
  "version": "0.0.1",
  "private": true,
  "description": "Advanced Predictive Analytics Platform",
  "author": "PredictIQ Inc.",
  "main": "electron/main.js",
  "build": {
    "appId": "com.predictiq.app",
    "productName": "PREDICTIQ",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/__tests__/**",
      "!electron/__mocks__/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint src electron *.js --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "react-native start",
    "dev": "npm run electron:dev",
    "build": "npm run electron:build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm test",
    "audit:deps": "npm audit --audit-level=high",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development webpack serve --mode development\" \"wait-on http://127.0.0.1:8080 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "cross-env NODE_ENV=production webpack --mode production && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@react-native-async-storage/async-storage": "1.19.3",
    "@react-navigation/bottom-tabs": "6.5.8",
    "@react-navigation/native": "6.1.7",
    "@react-navigation/stack": "6.3.17",
    "@reduxjs/toolkit": "1.9.5",
    "@types/uuid": "^11.0.0",
    "electron-store": "^11.0.2",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "openai": "^7.5.0",
    "pptxgenjs": "^4.0.1",
    "prop-types": "15.8.1",
    "react": "18.2.0",
    "react-globe.gl": "^2.37.0",
    "react-native": "0.72.6",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-gesture-handler": "2.12.1",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "4.7.1",
    "react-native-screens": "3.22.1",
    "react-redux": "8.1.2",
    "recharts": "^3.7.0",
    "styled-components": "6.0.7",
    "three": "^0.182.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "babel-loader": "^10.0.0",
    "babel-plugin-react-native-web": "^0.21.2",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.3",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "eslint": "^8.19.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.6",
    "javascript-obfuscator": "^5.2.1",
    "jest": "^29.2.1",
    "metro-config": "^0.76.9",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-dom": "18.2.0",
    "react-native-web": "^0.21.2",
    "react-native-windows": "0.72.31",
    "react-test-renderer": "18.2.0",
    "style-loader": "^4.0.0",
    "typescript": "4.8.4",
    "url-loader": "^4.1.1",
    "wait-on": "^9.0.3",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3",
    "webpack-obfuscator": "^3.6.0"
  },
  "engines": {
    "node": ">=16"
  }
}
